{
  "name": "Zoom Meeting Creator",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-entry",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "vene-hire-interview-created",
      "parameters": {
        "path": "vene-hire-interview-created",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "parameters": {
        "resource": "meeting",
        "operation": "create",
        "topic": "={{ $json.topic }}",
        "type": 2,
        "startTime": "={{ $json.start_time }}",
        "duration": "={{ $json.duration || 60 }}",
        "timezone": "={{ $json.timezone || 'America/Bogota' }}",
        "settings": {
          "joinBeforeHost": true,
          "waitingRoom": false,
          "hostVideo": true,
          "participantVideo": true,
          "muteUponEntry": true
        },
        "authentication": "oAuth2",
        "oauthAccountId": "zoom_oauth"
      },
      "id": "zoom-create",
      "name": "Create Zoom Meeting",
      "type": "n8n-nodes-base.zoom",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.VENE_HIRE_WEBHOOK_URL || 'http://localhost:3000/api/n8n-webhook' }}",
        "options": {
          "timeout": 10000,
          "allowUnauthorizedCerts": true
        },
        "sendBody": true,
        "bodyContentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "interview_id", "value": "={{ $json.interview_id }}", },
            { "name": "zoom_meeting_id", "value": "={{ $json.id }}", },
            { "name": "join_url", "value": "={{ $json.join_url }}", },
            { "name": "start_url", "value": "={{ $json.start_url }}", },
            { "name": "topic", "value": "={{ $json.topic }}", },
            { "name": "start_time", "value": "={{ $json.start_time }}", },
            { "name": "duration", "value": "={{ $json.duration }}", },
            { "name": "password", "value": "={{ $json.password }}", }
          ]
        }
      },
      "id": "callback",
      "name": "Callback to VeneHire",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300]
    },
    {
      "parameters": {
        "operation": "respondToWebhook",
        "responseCode": 200,
        "responseBody": "={\n  \"ok\": true,\n  \"meeting_id\": {{ $json.id }},\n  \"join_url\": \"{{ $json.join_url }}\"\n}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 500]
    }
  ],
  "connections": {
    "webhook-entry": {
      "main": [[ { "node": "zoom-create", "type": "main", "index": 0 } ]]
    },
    "zoom-create": {
      "main": [[ { "node": "callback", "type": "main", "index": 0 } ]]
    },
    "callback": {
      "main": [[ { "node": "respond", "type": "main", "index": 0 } ]]
    }
  },
  "active": true,
  "settings": {},
  "staticData": null,
  "tags": []
}
