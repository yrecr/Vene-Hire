{
  "name": "Zoom Meeting Creator",
  "nodes": [
    {
      "id": "webhook-entry",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "vene-hire-interview-created",
      "parameters": {
        "path": "vene-hire-interview-created",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "zoom-create",
      "name": "Create Zoom Meeting",
      "type": "n8n-nodes-base.zoom",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "zoomOAuth2Api": {
          "id": "zoom_oauth",
          "name": "Zoom OAuth2"
        }
      },
      "parameters": {
        "resource": "meeting",
        "operation": "create",
        "topic": "={{ $json.topic }}",
        "type": 2,
        "startTime": "={{ $json.start_time }}",
        "duration": "={{ $json.duration || 60 }}",
        "timezone": "={{ $json.timezone || 'America/Bogota' }}",
        "additionalFields": {
          "settings": {
            "joinBeforeHost": true,
            "waitingRoom": false,
            "hostVideo": true,
            "participantVideo": true,
            "muteUponEntry": true
          }
        },
        "authentication": "oAuth2"
      }
    },
    {
      "id": "merge-data",
      "name": "Merge Interview ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [750, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-interview-id",
              "name": "interview_id",
              "value": "={{ $('Webhook').item.json.interview_id }}",
              "type": "string"
            },
            {
              "id": "field-employer-id",
              "name": "employer_id",
              "value": "={{ $('Webhook').item.json.employer_id }}",
              "type": "string"
            },
            {
              "id": "field-applicant-id",
              "name": "applicant_id",
              "value": "={{ $('Webhook').item.json.applicant_id }}",
              "type": "string"
            },
            {
              "id": "field-join-url",
              "name": "join_url",
              "value": "={{ $json.join_url }}",
              "type": "string"
            },
            {
              "id": "field-start-url",
              "name": "start_url",
              "value": "={{ $json.start_url }}",
              "type": "string"
            },
            {
              "id": "field-meeting-id",
              "name": "zoom_meeting_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "field-topic",
              "name": "topic",
              "value": "={{ $json.topic }}",
              "type": "string"
            },
            {
              "id": "field-start-time",
              "name": "start_time",
              "value": "={{ $json.start_time }}",
              "type": "string"
            },
            {
              "id": "field-duration",
              "name": "duration",
              "value": "={{ $json.duration }}",
              "type": "number"
            },
            {
              "id": "field-password",
              "name": "password",
              "value": "={{ $json.password }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "includeOtherFields": true
        }
      }
    },
    {
      "id": "callback",
      "name": "Callback to VeneHire",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 150],
      "parameters": {
        "url": "={{ ($('Webhook').first().headers['x-app-url'] || 'http://localhost:3000') + '/api/n8n-webhook' }}",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ interview_id: $json.interview_id, zoom_meeting_id: $json.zoom_meeting_id, join_url: $json.join_url, start_url: $json.start_url, topic: $json.topic, start_time: $json.start_time, duration: $json.duration, password: $json.password, employer_id: $json.employer_id, applicant_id: $json.applicant_id }) }}",
        "options": {
          "timeout": 10000,
          "allowUnauthorizedCerts": true
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 450],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { id: $('Merge Interview ID').item.json.zoom_meeting_id, topic: $('Merge Interview ID').item.json.topic, join_url: $('Merge Interview ID').item.json.join_url, start_url: $('Merge Interview ID').item.json.start_url, start_time: $('Merge Interview ID').item.json.start_time, duration: $('Merge Interview ID').item.json.duration, password: $('Merge Interview ID').item.json.password } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[ { "node": "Create Zoom Meeting", "type": "main", "index": 0 } ]]
    },
    "Create Zoom Meeting": {
      "main": [[ { "node": "Merge Interview ID", "type": "main", "index": 0 } ]]
    },
    "Merge Interview ID": {
      "main": [
        [
          { "node": "Callback to VeneHire", "type": "main", "index": 0 },
          { "node": "Respond to Webhook", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": []
}
