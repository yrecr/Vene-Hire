# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, bypasses RLS. Never commit a real value
# or paste it anywhere outside your local .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# n8n — CV analysis workflow (DeepSeek)
# Webhook n8n calls to trigger analysis when an applicant uploads a resume.
N8N_RESUME_ANALYZE_WEBHOOK_URL=
# Shared secret n8n must send as the x-webhook-secret header when POSTing
# analysis results back to /api/candidates/webhook.
N8N_CANDIDATES_WEBHOOK_SECRET=
